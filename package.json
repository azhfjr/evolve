{
  "name": "evolve-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build",
    "db:local": "tsx scripts/local-database.ts",
    "predev": "npm run db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db:prepare": "tsx scripts/prepare-test-database.ts",
    "calendar:recover": "tsx scripts/calendar-recover.ts",
    "templates:board-room": "tsx scripts/board-room-templates.ts",
    "quality:cross": "playwright test --config playwright.cross.config.ts",
    "quality:scale": "tsx scripts/prepare-scale-fixture.ts && playwright test --config playwright.scale.config.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@vercel/blob": "2.8.2",
    "@vercel/queue": "0.8.0",
    "better-auth": "1.7.10",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.8",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "4.6.7"
    }
  }
}
