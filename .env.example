# Copy to .env.local. Never commit credentials.
NEXT_PUBLIC_APP_NAME=Evolve
BETTER_AUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sole administrator; never derived from request data.
ADMIN_EMAIL=jarjirjor777@gmail.com
# Production: managed PostgreSQL pooled URL, with TLS enabled.
DATABASE_URL=
# Only for local development/verification; NEVER enable on Vercel.
EVOLVE_LOCAL_DATABASE=1

# Direct PostgreSQL URL for LISTEN/NOTIFY; keep the pooled URL above for queries.
DATABASE_URL_UNPOOLED=
# Private Vercel Blob store token. Set through Vercel's secure settings.
BLOB_READ_WRITE_TOKEN=
# Vercel Cron recovery for abandoned uploads and pending Calendar dispatch.
# Generate at least 32 random characters; keep this server-side.
CRON_SECRET=
# Local files only; never enable on Vercel. Optional directory for development.
EVOLVE_FILES_DIR=.data/files
# Optional operational pause for new uploads before task creation; existing task files remain available.
EVOLVE_DISABLE_TASK_DRAFT_UPLOADS=0
